from dataclasses import dataclass
from pathlib import Path
import os
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parents[2]

def truth(name: str, default: str = "false") -> bool:
    return os.getenv(name, default).strip().lower() in {"1", "true", "yes", "on"}

@dataclass(frozen=True)
class Settings:
    state_path: Path
    engine: str = "auto"
    session_ttl: int = 86400
    approval_ttl: int = 600
    max_rounds: int = 4
    model_budget: float = 18.0
    knowledge_path: Path = ROOT / "knowledge" / "agent"

    @classmethod
    def from_env(cls):
        path = Path(os.getenv("DIGITALHELPER_AGENT_STATE_PATH", "output/agent/state.sqlite3"))
        if not path.is_absolute():
            path = ROOT / path
        mode = os.getenv("DIGITALHELPER_AGENT_ENGINE", "auto").lower().strip()
        if mode not in {"auto", "native", "langgraph"}:
            raise ValueError("DIGITALHELPER_AGENT_ENGINE must be auto/native/langgraph")
        return cls(path.resolve(), engine=mode)

    @property
    def checkpoint_path(self):
        return self.state_path.with_name(self.state_path.stem + "-checkpoints.sqlite3")

def model_config() -> dict | None:
    """Reuse the existing server-side env names, never exposing the key to clients."""
    key = os.getenv("DIGITALHELPER_LLM_API_KEY", "").strip()
    base = os.getenv("DIGITALHELPER_LLM_BASE_URL", "").strip().rstrip("/")
    model = os.getenv("DIGITALHELPER_LLM_MODEL", "").strip()
    protocol = os.getenv("DIGITALHELPER_LLM_PROTOCOL", "openai-compatible").strip()
    try:
        url = urlsplit(base)
        valid = (url.scheme == "https" or (url.scheme == "http" and url.hostname in
                 {"localhost", "127.0.0.1", "::1"}))
        valid = valid and bool(url.hostname) and not (url.username or url.password or url.query or url.fragment)
    except ValueError:
        return None
    # The original /api/chat still supports Anthropic. Agent tool-use v1 only
    # supports Chat Completions tool_calls, and reports a deterministic fallback.
    if not (key and model and valid and protocol == "openai-compatible"):
        return None
    return {"key": key, "base": base, "model": model}
